rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Contacts: only admin (mohdhaziq1962@gmail.com) can read/update/delete
    // Anyone authenticated can create (from contact form)
    match /contacts/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null 
        && request.auth.token.email == 'mohdhaziq1962@gmail.com';
    }
    
    // Projects: admin can do everything
    // Clients can only read their own projects (by clientEmail)
    // Anyone authenticated can create (from contact form / client portal)
    match /projects/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null 
        && (request.auth.token.email == 'mohdhaziq1962@gmail.com'
            || resource.data.clientEmail == request.auth.token.email);
      allow update, delete: if request.auth != null 
        && request.auth.token.email == 'mohdhaziq1962@gmail.com';
    }

    // Uploads (Image Gallery): anyone can read (image URLs are public - shown on website)
    // Only admin can create/update/delete
    match /uploads/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == 'mohdhaziq1962@gmail.com';
    }

    // SSH Keys: admin only can read/create/delete (private keys - sensitive data)
    // Server-side API uses Firebase Admin SDK for reads
    match /sshKeys/{docId} {
      allow create, read, update, delete: if request.auth != null
        && request.auth.token.email == 'mohdhaziq1962@gmail.com';
    }

    // Videos/Reels: anyone can READ (video embeds shown on portfolio)
    // Only admin can create/update/delete
    match /videos/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == 'mohdhaziq1962@gmail.com';
    }

    // Client Uploads: clients upload files/images for admin to view + download
    // - Any logged-in user can CREATE (upload)
    // - Admin sees ALL; client sees only OWN uploads
    // - Admin or owner can delete
    match /clientUploads/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
        && (request.auth.token.email == 'mohdhaziq1962@gmail.com'
            || resource.data.clientEmail == request.auth.token.email);
      allow update, delete: if request.auth != null
        && (request.auth.token.email == 'mohdhaziq1962@gmail.com'
            || resource.data.clientEmail == request.auth.token.email);
    }

    // Client Mockups (Free Mockup): client submits a mockup request with their client_id
    // - Any logged-in user can CREATE (submit a free mockup request)
    // - Admin can read/update/delete all
    // - Client can read only their own requests
    match /clientMockups/{docId} {
      allow create: if request.auth != null
        && request.resource.data.clientEmail == request.auth.token.email;
      allow read: if request.auth != null
        && (request.auth.token.email == 'mohdhaziq1962@gmail.com'
            || resource.data.clientEmail == request.auth.token.email);
      allow update, delete: if request.auth != null
        && request.auth.token.email == 'mohdhaziq1962@gmail.com';
    }
  }
}
